{
  "package_version": 2,
  "name": "native-hot-update-toolkit",
  "version": "0.13.1",
  "title": "项目发布中心",
  "description": "Android APK/Bundle 与 Web 多环境构建、预检、归档和发布中心。",
  "author": "Gala Client",
  "editor": ">=3.8.0",
  "main": "./main.js",
  "panels": {
    "default": {
      "title": "项目发布中心",
      "main": "./panel/index.js",
      "type": "dockable",
      "size": {
        "width": 1180,
        "height": 780,
        "min-width": 820,
        "min-height": 600
      }
    }
  },
  "contributions": {
    "menu": [
      {
        "path": "项目工具",
        "label": "热更新",
        "message": "open-panel"
      }
    ],
    "messages": {
      "open-panel": { "methods": ["openPanel"] },
      "panel-ready": { "methods": ["panelReady"] },
      "get-state": { "methods": ["getState"] },
      "initialize-config": { "methods": ["initializeConfig"] },
      "save-config": { "methods": ["saveConfig"] },
      "run-pipeline": { "methods": ["runPipeline"] },
      "run-web-release": { "methods": ["runWebRelease"] },
      "inspect-web-release": { "methods": ["inspectCurrentWebRelease"] },
      "save-web-release-config": { "methods": ["saveCurrentWebRelease"] },
      "stop-pipeline": { "methods": ["stopPipeline"] },
      "refresh-releases": { "methods": ["refreshReleases"] },
      "select-release": { "methods": ["selectRelease"] },
      "load-release-file": { "methods": ["loadReleaseFile"] },
      "open-path": { "methods": ["openPath"] },
      "copy-publish-manifest": { "methods": ["copyPublishManifest"] },
      "state-updated": { "methods": ["default.updateState"] }
    }
  }
}
